class Solution {
public:
    vector<int> findMissingRepeatingNumbers(vector<int> nums) {
        vector<int> freq(nums.size()+1,0);
         
        for(int num:nums)
        freq[num]++;

        int a=-1, b=-1;

        for(int i=1;i<=nums.size();i++)
        {
            if(freq[i]==2)
            a=i;
            if(freq[i]==0)
            b=i;
        }

        return {a,b};

    }
};
//TC->O(N) || SC->O(N)
