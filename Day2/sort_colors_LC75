class Solution {
public:
    void sortColors(vector<int>& nums) {
        //dutch national flag problem
        int i=0, k=0, j=nums.size()-1;

        while(k<=j)
        {
            if(nums[k]==1)
            k++;
            else if(nums[k]==2)
            {
                int t=nums[k];
                nums[k]=nums[j];
                nums[j]=t;
                j--;
            }
            else
            {
                int t=nums[k];
                nums[k]=nums[i];
                nums[i]=t;
                k++;
                i++;
            }
        }
        

    }
};
//TC->O(N) || SC->O(1)
