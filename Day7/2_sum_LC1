class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        unordered_map<int, int> mp; // use unordered_map for O(1) avg

        for(int i = 0; i < nums.size(); i++)
        {
            int complement = target - nums[i];

            if(mp.count(complement)) {
                return {mp[complement], i}; // return immediately
            }

            mp[nums[i]] = i; // store current number + index
        }
        return {}; // no solution found
    }
};
